# PresenceIQ Backend — copy to .env.local (never commit .env.local)
# Setup guide: ./SETUP.md  |  Index: ../docs/ENV.md

# ═══ REQUIRED — local dev ═══════════════════════════════════
# Convex: https://dashboard.convex.dev → project adamant-puffin-769
CONVEX_DEPLOYMENT=dev:adamant-puffin-769
NEXT_PUBLIC_CONVEX_URL=https://adamant-puffin-769.convex.cloud

# OpenAI: https://platform.openai.com/api-keys (GPT-4o intent scoring)
OPENAI_API_KEY=sk-your-openai-key-here

# Public URL for embed script + API calls
# Use :3001 if you run `npm run dev:3001` (embed script BASE URL)
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Vite product UI — browser redirect from API `/` goes here (npm run dev in frontend/)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:5173

# Clerk (dashboard sign-in) — https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# ═══ BEYOND PRESENCE — live avatar (server-side only; do not put in avatar/.env) ═══
# Keys: https://app.bey.chat/settings — header x-api-key on api.bey.dev
BEYONDPRESENCE_API_KEY=sk-your-beyondpresence-key-here
# BEYONDPRESENCE_API_BASE_URL=https://api.bey.dev

# ═══ WEBHOOKS — generate random strings (openssl rand -hex 16) ═══
N8N_WEBHOOK_SECRET=dev-n8n-secret-change-me
BP_WEBHOOK_SECRET=dev-bp-secret-change-me

# ═══ OPTIONAL — Seylan Bank sandbox (hackathon Team 8) ═══════════════
# Sandbox only — never production Seylan. Header: x-api-key on every request.
SEYLAN_API_BASE_URL=http://34.21.206.87:3000
SEYLAN_API_KEY=your-team-api-key-here
# Path from Seylan Web API Manual ({accountNumber} replaced at runtime):
SEYLAN_CUSTOMER_LOOKUP_PATH=/api/accounts/{accountNumber}
SEYLAN_DEMO_ACCOUNT_NUMBER=064000012548001

# ═══ OPTIONAL — n8n Cloud webhooks (import devops/n8n/*.workflow.json) ═══
# Activate workflows in n8n Cloud → copy Production Webhook URLs here
N8N_WEBHOOK_CRM_FETCH=https://your-instance.app.n8n.cloud/webhook/presenceiq-crm-fetch
N8N_WEBHOOK_SLACK=https://your-instance.app.n8n.cloud/webhook/presenceiq-hot-lead
N8N_WEBHOOK_CRM_PUSH=https://your-instance.app.n8n.cloud/webhook/presenceiq-crm-push
N8N_WEBHOOK_CHURN=https://your-instance.app.n8n.cloud/webhook/presenceiq-churn-email

# ═══ OPTIONAL — Convex deploy / CI only ═══════════════════════
# Dashboard → Settings → Deploy Key (NOT the dev:slug|eyJ... token from convex dev)
CONVEX_DEPLOY_KEY=

# ═══ OPTIONAL — auto-added by `npx convex dev` ════════════════
# NEXT_PUBLIC_CONVEX_SITE_URL=https://adamant-puffin-769.convex.site

# ═══ CONVEX DEPLOYMENT ONLY (not in .env.local) ════════════════
# Clerk dashboard → activate Convex integration → Frontend API URL:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#
# Link your user to Seylan demo after seed:
#   npx convex run seed:seedDemo '{"clerkUserId":"user_..."}'
