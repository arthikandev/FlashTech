# PresenceIQ Backend — copy to .env.local (never commit .env.local)
# Setup guide: ./SETUP.md  |  Index: ../docs/ENV.md

# ═══ REQUIRED — local dev ═══════════════════════════════════
# Convex: https://dashboard.convex.dev → project adamant-puffin-769
CONVEX_DEPLOYMENT=dev:adamant-puffin-769
NEXT_PUBLIC_CONVEX_URL=https://adamant-puffin-769.convex.cloud

# OpenAI: https://platform.openai.com/api-keys (GPT-4o intent scoring)
OPENAI_API_KEY=sk-your-openai-key-here

# Public URL for embed script + API calls (matches `npm run dev` on port 3001)
NEXT_PUBLIC_APP_URL=http://localhost:3001
# Vite product UI — browser redirect from API `/` goes here (npm run dev in frontend/)
NEXT_PUBLIC_FRONTEND_URL=http://localhost:5173

# Clerk (dashboard sign-in) — https://dashboard.clerk.com/last-active?path=api-keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# ElevenLabs — voice selection for Beyond Presence agents (health probe)
ELEVENLABS_API_KEY=your-elevenlabs-key-here

# ═══ BEYOND PRESENCE — live avatar (server-side only; do not put in avatar/.env) ═══
# Keys: https://app.bey.chat/settings — header x-api-key on api.bey.dev
BEYONDPRESENCE_API_KEY=sk-your-beyondpresence-key-here
# BEYONDPRESENCE_API_BASE_URL=https://api.bey.dev

# ═══ WEBHOOKS — generate random strings (openssl rand -hex 16) ═══
# Secret your automation MUST send as header X-Webhook-Secret when PATCHing Convex via inbound CRM ingest.
INBOUND_WEBHOOK_SECRET=dev-inbound-webhook-secret-change-me
# Legacy alias (still read if INBOUND_WEBHOOK_SECRET unset)
N8N_WEBHOOK_SECRET=dev-inbound-webhook-secret-change-me
BP_WEBHOOK_SECRET=dev-bp-secret-change-me

# ═══ OPTIONAL — outbound HTTPS automation (any workflow tool) ═══
# PresenceIQ POSTs visitor context to WEBHOOK_CRM_FETCH_TRIGGER; enrichment tools should call back:
#   POST ${NEXT_PUBLIC_APP_URL}/api/webhooks/crm-ingest  (header X-Webhook-Secret = INBOUND_WEBHOOK_SECRET)
# Per-workspace URLs in Convex (business.webhookUrls) override defaults below.
WEBHOOK_CRM_FETCH_TRIGGER=https://your-automation-provider.example/hooks/crm-fetch
WEBHOOK_SLACK_HOT_LEAD=https://your-automation-provider.example/hooks/hot-lead
WEBHOOK_CRM_PUSH=https://your-automation-provider.example/hooks/crm-push
WEBHOOK_CHURN_RISK=https://your-automation-provider.example/hooks/churn
# Legacy N8N_WEBHOOK_* env names are still read if the WEBHOOK_* keys above are empty.

# ═══ OPTIONAL — pipeline tuning ═══════════════════════════════
# Cap on the synchronous portion of POST /api/pipeline (ms). Beyond Presence
# agent PATCH is raced against the remaining budget; if it loses it finishes
# in the background and the response returns syncStatus="pending".
# PRESENCEIQ_PIPELINE_CEILING_MS=1500
# Enables the "sarangan" demo-fixture shortcut in scoreIntent. Off in prod.
# PRESENCEIQ_ALLOW_DEMO_FIXTURES=true

# ═══ OPTIONAL — Convex deploy / CI only ═══════════════════════
# Dashboard → Settings → Deploy Key (NOT the dev:slug|eyJ... token from convex dev)
CONVEX_DEPLOY_KEY=

# ═══ OPTIONAL — auto-added by `npx convex dev` ════════════════
# NEXT_PUBLIC_CONVEX_SITE_URL=https://adamant-puffin-769.convex.site

# ═══ CONVEX + CLERK (deploy notes) ═════════════════════════════
# Clerk shows this as "Frontend API" / CLERK_FRONTEND_API_URL (same URL). On Convex use:
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
# Clerk dashboard → activate Convex integration → Frontend API URL:
