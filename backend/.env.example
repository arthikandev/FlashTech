# PresenceIQ Backend — copy to .env.local (never commit .env.local)
# Full index: ../docs/ENV.md

# ── Convex (Person 2) ─────────────────────────────────────
CONVEX_DEPLOYMENT=dev:adamant-puffin-769
NEXT_PUBLIC_CONVEX_URL=https://adamant-puffin-769.convex.cloud

# CONVEX_DEPLOY_KEY — Convex Dashboard → Settings → Deploy Key (for `npx convex deploy` / CI)
# NOT the "dev:slug|eyJ..." string from `npx convex dev` — that token is written to .env.local by `convex dev`
CONVEX_DEPLOY_KEY=

# ── OpenAI (pre-conversation intent scoring only) ─────────
OPENAI_API_KEY=

# ── Clerk (dashboard sign-in) ───────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# ── Next.js app ───────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3001

# ── Webhooks (must match avatar + n8n — see docs/ENV.md) ──
N8N_WEBHOOK_SECRET=change-me-n8n-secret
BP_WEBHOOK_SECRET=change-me-bp-secret

# Outbound: backend POSTs to these n8n webhook URLs (optional until n8n is wired)
N8N_WEBHOOK_CRM_FETCH=
N8N_WEBHOOK_CRM_PUSH=
N8N_WEBHOOK_SLACK=
