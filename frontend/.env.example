# PresenceIQ Frontend (Person 3) — copy to .env.local
# Index: ../docs/ENV.md
# VITE_CONVEX_URL must match backend NEXT_PUBLIC_CONVEX_URL

# Local dev (also see .env.development)
# Optional. If unset, dev uses Vite proxy /app → http://localhost:3001
VITE_BACKEND_URL=http://localhost:3001
VITE_CONVEX_URL=https://adamant-puffin-769.convex.cloud

# Clerk publishable key (pk_test_… / pk_live_…) — NOT the Frontend API URL.
# Frontend API URL → Convex: npx convex env set CLERK_JWT_ISSUER_DOMAIN https://….clerk.accounts.dev
# Optional — same URL for auth troubleshooting UI (WorkspaceAuthGate)
# VITE_CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# Copy from backend NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY or frontend/.env.development
# Activate Clerk → Convex integration (JWT template "convex")
VITE_CLERK_PUBLISHABLE_KEY=

# Optional Beyond Presence demo agent (unsigned preview / fallback iframe).
# Default in code matches https://bey.chat/9fe4cbe8-2f99-4b8e-9dda-60f32846300a — override if needed.
# VITE_BP_DEMO_AGENT_ID=9fe4cbe8-2f99-4b8e-9dda-60f32846300a

# Production (Vercel): set same keys in Dashboard → Env for **Production** (+ Preview).
# npm run build bakes these in (Vite):
# VITE_BACKEND_URL=https://your-backend.vercel.app
# VITE_CONVEX_URL=https://your-deployment.convex.cloud
# VITE_CLERK_PUBLISHABLE_KEY=pk_live_...

# Production URLs live in .env.production (Vercel build). Test prod API locally:
#   npm run dev:deployed
