{
  "name": "PresenceIQ CRM Fetch",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "presenceiq-crm-fetch",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-crm-fetch",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "presenceiq-crm-fetch"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PRESENCEIQ_BACKEND_URL }}/api/seylan/account-inquiry",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ accountNumber: $env.SEYLAN_DEMO_ACCOUNT_NUMBER || '064000012548001', crmId: ($json.body || $json).crmId || 'CRM-001' }) }}",
        "options": {
          "timeout": 8000
        }
      },
      "id": "seylan-inquiry",
      "name": "Seylan via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [480, 300],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const input = $('Webhook').first().json.body || $('Webhook').first().json;\nconst seylan = $input.first().json;\nconst sarangan = {\n  name: 'Sarangan',\n  email: 'sarangan@example.com',\n  accountType: 'prospect',\n  churnRisk: 'low',\n  notes: 'Compared Gold and Platinum plans 3 times this week'\n};\nlet crmId = input.crmId || 'CRM-001';\nlet crmData = sarangan;\nif (seylan?.data?.crmData?.name) {\n  crmData = seylan.data.crmData;\n  crmId = seylan.data.crmId || crmId;\n} else if (seylan?.crmData?.name) {\n  crmData = seylan.crmData;\n  crmId = seylan.crmId || crmId;\n}\nreturn [{ json: { visitorId: input.visitorId, crmId, crmData } }];"
      },
      "id": "map-crm",
      "name": "Map CRM Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [720, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.PRESENCEIQ_BACKEND_URL }}/api/webhooks/n8n/crm",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Webhook-Secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}"
      },
      "id": "post-presenceiq",
      "name": "POST to PresenceIQ",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [960, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ ok: true, patched: true }) }}"
      },
      "id": "respond-ok",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1180, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Seylan via Backend", "type": "main", "index": 0 }]]
    },
    "Seylan via Backend": {
      "main": [[{ "node": "Map CRM Payload", "type": "main", "index": 0 }]]
    },
    "Map CRM Payload": {
      "main": [[{ "node": "POST to PresenceIQ", "type": "main", "index": 0 }]]
    },
    "POST to PresenceIQ": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
