{
  "name": "PresenceIQ CRM Push",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "presenceiq-crm-push",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-crm-push",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "presenceiq-crm-push"
    },
    {
      "parameters": {
        "jsCode": "const payload = $input.first().json.body || $input.first().json;\nreturn [{ json: {\n  logged: true,\n  visitorId: payload.visitorId,\n  businessId: payload.businessId,\n  outcome: payload.outcome,\n  intentScore: payload.intentScore,\n  actionItems: payload.actionItems,\n  transcriptTurns: Array.isArray(payload.transcript) ? payload.transcript.length : 0,\n  at: new Date().toISOString()\n} }];"
      },
      "id": "log-crm",
      "name": "Log CRM Update",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify($json) }}"
      },
      "id": "respond-push",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [700, 300]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Log CRM Update", "type": "main", "index": 0 }]]
    },
    "Log CRM Update": {
      "main": [[{ "node": "Respond to Webhook", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
